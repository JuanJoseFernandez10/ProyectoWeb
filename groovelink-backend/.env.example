# ============================================
# GROOVELINK BACKEND - Variables de Entorno
# ============================================
# Copia este archivo como .env o configura
# estas variables en el panel de Render

# ---- Puerto ----
# Render asigna PORT automáticamente
# PORT=8080

# ---- Base de Datos (PostgreSQL en Render) ----
DATABASE_URL=jdbc:postgresql://<host>:<port>/<dbname>
DATABASE_USERNAME=<usuario>
DATABASE_PASSWORD=<contraseña>

# ---- JWT ----
APP_JWT_SECRET=<clave-segura-minimo-64-caracteres>
APP_JWT_EXPIRATION=86400000

# ---- Admin por defecto (se crea al iniciar si no existe) ----
APP_SEED_ADMIN_ENABLED=true
APP_DEFAULT_ADMIN_USERNAME=admin
APP_DEFAULT_ADMIN_EMAIL=admin@example.com
APP_DEFAULT_ADMIN_PASSWORD=<cambiar-contraseña>
APP_DEFAULT_ADMIN_CARGO=SUPERADMIN

# ---- CORS (orígenes separados por coma) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://<frontend>.vercel.app

# ---- Email (SMTP - opcional) ----
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=<tu-email>
# MAIL_PASSWORD=<tu-contraseña>
# MAIL_TIMEOUT=5000

# ---- Fotos (usar almacenamiento externo en producción) ----
# APP_FOTOS_BASE_DIR=/tmp/groovelink/fotos-evento
# APP_FOTOS_PERFIL_DIR=/tmp/groovelink/fotos-perfil
