{
  "info": {
    "_postman_id": "9d6f7a2d-6f89-4f7b-b2aa-13052026gl",
    "name": "GrooveLink API Final 13-05-26",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('TOKEN', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{LOGIN_USERNAME}}\",\n  \"password\": \"{{LOGIN_PASSWORD}}\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register Empresa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{REGISTER_EMPRESA_USERNAME}}\",\n  \"email\": \"{{REGISTER_EMPRESA_EMAIL}}\",\n  \"password\": \"{{REGISTER_EMPRESA_PASSWORD}}\",\n  \"role\": \"ROLE_EMPRESA\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Home y Eventos",
      "item": [
        {
          "name": "Cargar Home",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/home?page=0&size=5",
              "host": ["{{BASE_URL}}"],
              "path": ["home"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Mis Eventos (token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "url": { "raw": "{{BASE_URL}}/eventos/mis-eventos", "host": ["{{BASE_URL}}"], "path": ["eventos", "mis-eventos"] }
          }
        },
        {
          "name": "Mis Eventos (por username)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/eventos/mis-eventos?username={{TARGET_USERNAME}}",
              "host": ["{{BASE_URL}}"],
              "path": ["eventos", "mis-eventos"],
              "query": [{ "key": "username", "value": "{{TARGET_USERNAME}}" }]
            }
          }
        },
        {
          "name": "Crear Evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.codigo) pm.collectionVariables.set('EVENT_ID', String(json.codigo));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Evento Postman Final\",\n  \"ubicacion\": \"Madrid\",\n  \"descripcion\": \"Creado desde colección final\",\n  \"fechaInicio\": \"2026-12-20\",\n  \"fechaFinal\": \"2026-12-21\",\n  \"aptitudesIds\": [],\n  \"generosIds\": []\n}"
            },
            "url": { "raw": "{{BASE_URL}}/eventos", "host": ["{{BASE_URL}}"], "path": ["eventos"] }
          }
        },
        {
          "name": "Editar Evento",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Evento Postman Final Editado\",\n  \"ubicacion\": \"Madrid Centro\",\n  \"descripcion\": \"Editado desde colección final\",\n  \"fechaInicio\": \"2026-12-20\",\n  \"fechaFinal\": \"2026-12-22\",\n  \"aptitudesIds\": [],\n  \"generosIds\": []\n}"
            },
            "url": { "raw": "{{BASE_URL}}/eventos/{{EVENT_ID}}", "host": ["{{BASE_URL}}"], "path": ["eventos", "{{EVENT_ID}}"] }
          }
        },
        {
          "name": "Poner Me Gusta",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "url": { "raw": "{{BASE_URL}}/eventos/{{EVENT_ID}}/me-gusta", "host": ["{{BASE_URL}}"], "path": ["eventos", "{{EVENT_ID}}", "me-gusta"] }
          }
        },
        {
          "name": "Quitar Me Gusta",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "url": { "raw": "{{BASE_URL}}/eventos/{{EVENT_ID}}/me-gusta", "host": ["{{BASE_URL}}"], "path": ["eventos", "{{EVENT_ID}}", "me-gusta"] }
          }
        },
        {
          "name": "Eliminar Evento",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "url": { "raw": "{{BASE_URL}}/eventos/{{EVENT_ID}}", "host": ["{{BASE_URL}}"], "path": ["eventos", "{{EVENT_ID}}"] }
          }
        }
      ]
    },
    {
      "name": "Perfil",
      "item": [
        {
          "name": "Mi Perfil",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "url": { "raw": "{{BASE_URL}}/usuarios/me", "host": ["{{BASE_URL}}"], "path": ["usuarios", "me"] }
          }
        },
        {
          "name": "Actualizar Perfil",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"descripcion\": \"Bio actualizada desde Postman final\"\n}" },
            "url": { "raw": "{{BASE_URL}}/usuarios/me", "host": ["{{BASE_URL}}"], "path": ["usuarios", "me"] }
          }
        },
        {
          "name": "Subir Foto Perfil",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "foto", "type": "file", "src": "" }]
            },
            "url": { "raw": "{{BASE_URL}}/usuarios/me/foto-perfil", "host": ["{{BASE_URL}}"], "path": ["usuarios", "me", "foto-perfil"] }
          }
        },
        {
          "name": "Descargar Foto Perfil por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "image/*" }],
            "url": { "raw": "{{BASE_URL}}/usuarios/perfiles/{{USER_ID}}/foto", "host": ["{{BASE_URL}}"], "path": ["usuarios", "perfiles", "{{USER_ID}}", "foto"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:8080" },
    { "key": "TOKEN", "value": "" },
    { "key": "EVENT_ID", "value": "1" },
    { "key": "USER_ID", "value": "1" },
    { "key": "TARGET_USERNAME", "value": "juan" },
    { "key": "LOGIN_USERNAME", "value": "admin" },
    { "key": "LOGIN_PASSWORD", "value": "admin123" },
    { "key": "REGISTER_EMPRESA_USERNAME", "value": "empresa_postman_1305" },
    { "key": "REGISTER_EMPRESA_EMAIL", "value": "empresa_postman_1305@local.dev" },
    { "key": "REGISTER_EMPRESA_PASSWORD", "value": "Emp12345!" }
  ]
}